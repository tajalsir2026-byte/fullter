<?xml version="1.0" encoding="utf-8"?>
<!--
  تطبيق مالي: نمنع النسخ الاحتياطي التلقائي لسحابة جوجل ونقل البيانات
  بين الأجهزة، لأن البيانات حسّاسة. النسخ الاحتياطي يتم يدوياً من داخل التطبيق.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
